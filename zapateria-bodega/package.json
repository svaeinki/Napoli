{
  "name": "napoli-reparadora",
  "version": "2.0.0",
  "description": "Sistema de gestión de bodega para Napoli - Reparadora de Calzado",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --win",
    "build-mac": "electron-builder --mac",
    "build-win": "electron-builder --win"
  },
  "keywords": [
    "electron",
    "bodega",
    "reparadora",
    "calzado",
    "napoli",
    "sqlite"
  ],
  "author": "Diego Moreno",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9"
  },
  "overrides": {
    "node-gyp": "^10.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "dropbox": "^10.34.0",
    "exceljs": "^4.4.0",
    "isomorphic-fetch": "^3.0.0"
  },
  "build": {
    "appId": "com.napoli.reparadora",
    "productName": "Napoli Reparadora",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.map",
      "!dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    }
  }
}
