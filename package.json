{
  "name": "napoli-reparadora",
  "version": "2.0.9",
  "description": "Sistema de gestión de bodega para Napoli - Reparadora de Calzado",
  "main": "main.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "start": "node scripts/start-electron.js",
    "rebuild": "electron-builder install-app-deps",
    "test": "node --test scripts/tests/*.test.js",
    "test:electron": "node scripts/test-electron.js",
    "build": "node scripts/build-installer.js --win --mac --linux",
    "build-mac": "node scripts/build-installer.js --mac",
    "build-win": "node scripts/build-installer.js --win",
    "build-linux": "node scripts/build-installer.js --linux",
    "check:syntax": "node scripts/check-syntax.js",
    "check:audit": "yarn npm audit --recursive --environment production --severity high",
    "check:build-current": "node scripts/check-build-current.js",
    "check:build-win": "electron-builder --win --publish never",
    "release:check": "yarn run check:syntax && yarn run check:audit && yarn run check:build-current"
  },
  "keywords": [
    "electron",
    "bodega",
    "reparadora",
    "calzado",
    "napoli",
    "sqlite"
  ],
  "author": "Diego Moreno",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svaeinki/Napoli.git"
  },
  "bugs": {
    "url": "https://github.com/svaeinki/Napoli/issues"
  },
  "homepage": "https://github.com/svaeinki/Napoli#readme",
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=4.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "^40.6.0",
    "electron-builder": "^26.5.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "dropbox": "^10.34.0",
    "excel4node": "patch:excel4node@npm%3A1.8.2#~/.yarn/patches/excel4node-npm-1.8.2-0f229007c7.patch",
    "isomorphic-fetch": "^3.0.0"
  },
  "resolutions": {
    "node-gyp": "^11.5.0",
    "image-size": "^2.0.3"
  },
  "dependenciesMeta": {
    "better-sqlite3": {
      "built": true
    },
    "electron": {
      "built": true
    },
    "electron-winstaller": {
      "built": true
    }
  },
  "build": {
    "appId": "com.napoli.reparadora",
    "productName": "Napoli Reparadora",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.map",
      "!dist/**/*",
      "!.yarn/**/*",
      "!.yarnrc.yml",
      "!scripts/**/*",
      "!PROBLEMAS.md"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
