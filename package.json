{
  "name": "napoli-reparadora",
  "version": "2.0.0",
  "description": "Sistema de gestión de bodega para Napoli - Reparadora de Calzado",
  "main": "main.js",
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "start": "node scripts/start-electron.js",
    "rebuild": "electron-rebuild",
    "build": "electron-builder --mac --win",
    "build-mac": "electron-builder --mac",
    "build-win": "electron-builder --win"
  },
  "keywords": [
    "electron",
    "bodega",
    "reparadora",
    "calzado",
    "napoli",
    "sqlite"
  ],
  "author": "Diego Moreno",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "^40.6.0",
    "electron-builder": "^22.14.13",
    "electron-rebuild": "^2.0.3"
  },
  "overrides": {
    "node-gyp": "^10.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "dropbox": "^10.34.0",
    "exceljs": "^4.1.1",
    "isomorphic-fetch": "^3.0.0",
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "com.napoli.reparadora",
    "productName": "Napoli Reparadora",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.map",
      "!dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    }
  }
}
