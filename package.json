{
  "name": "napoli-reparadora",
  "version": "2.0.9",
  "description": "Sistema de gestión de bodega para Napoli - Reparadora de Calzado",
  "main": "main.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "start": "node scripts/start-electron.js",
    "rebuild": "electron-builder install-app-deps",
    "test": "node --test scripts/tests/*.test.js",
    "build": "electron-builder --win --mac --linux",
    "build-mac": "electron-builder --mac",
    "build-win": "electron-builder --win",
    "build-linux": "electron-builder --linux",
    "check:syntax": "node scripts/check-syntax.js",
    "check:audit": "npm audit --omit=dev --audit-level=high",
    "check:build-current": "node scripts/check-build-current.js",
    "check:build-win": "electron-builder --win --publish never",
    "release:check": "npm run check:syntax && npm run check:audit && npm run check:build-current"
  },
  "keywords": [
    "electron",
    "bodega",
    "reparadora",
    "calzado",
    "napoli",
    "sqlite"
  ],
  "author": "Diego Moreno",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "^40.6.0",
    "electron-builder": "^26.5.0"
  },
  "overrides": {
    "node-gyp": "^10.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "dropbox": "^10.34.0",
    "excel4node": "^1.8.2",
    "isomorphic-fetch": "^3.0.0"
  },
  "build": {
    "appId": "com.napoli.reparadora",
    "productName": "Napoli Reparadora",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.map",
      "!dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
